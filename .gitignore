# Project specific — block data exports only
/exports/
/data/
*.csv
*.parquet

# Block only data/export json files, NOT project config files
/data/*.json
/exports/*.json

# Explicitly allow all project config JSON files
!package.json
!package-lock.json
!tsconfig.json
!tsconfig*.json
!vite.config.json
!vercel.json
!**/package.json
!**/package-lock.json
!**/tsconfig.json
!**/vercel.json
!docs/*.json
!configs/*.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.cache/
.env
